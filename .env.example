HOST=0.0.0.0
PORT=8787
PUBLIC_BASE_URL=https://live.example.com
HOST_TOKEN=change-me-before-tea-party

# OpenAI-compatible translator. Point this at Hermes proxy after
# `hermes proxy`. Inside Docker use host.docker.internal, not 127.0.0.1.
OPENAI_BASE_URL=http://host.docker.internal:8642/v1
OPENAI_API_KEY=unused
OPENAI_MODEL=grok-4.6

# Optional fallback if Hermes is down.
GROQ_API_KEY=
